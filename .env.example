# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   set -a && source .env && set +a
#   python -m tests.test_cloud_api

# Cloud API — get a key from https://developer.govee.com
GOVEE_API_KEY=

# A device to run the tests against. Get the id and SKU from get_devices().
GOVEE_TEST_DEVICE_ID=
GOVEE_TEST_DEVICE_SKU=
GOVEE_TEST_DEVICE_NAME=Test Device

# LAN API — the device's address on your network. LAN control must be enabled
# for the device in the Govee app.
GOVEE_TEST_DEVICE_IP=
